# Copy this file to config.env, or run sdf --setup for interactive setup.
# This file only demonstrates the format. The real config.env is created with mode 600.

# DeepSeek (recommended paid option)
PROVIDER=deepseek
PROVIDER_NAME=DeepSeek
API_KEY=<your_api_key>
BASE_URL=https://api.deepseek.com
MODEL=deepseek-v4-flash

# Zhipu free model:
# PROVIDER=zhipu
# PROVIDER_NAME=Zhipu GLM
# API_KEY=<your_zhipu_api_key>
# BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL=glm-4.7-flash

# For any OpenAI-compatible provider, replace these values:
# PROVIDER=openai-compatible
# PROVIDER_NAME=<provider_name>
# BASE_URL=https://provider.example/v1
# MODEL=<model_name>

# Gemini uses this format:
# PROVIDER=gemini
# PROVIDER_NAME=Gemini
# MODEL=gemini-2.5-flash

# Run sdf --setup to select other built-in free or rate-limited providers:
# - Groq Free
# - OpenRouter Free Router
# - GitHub Models
# - SiliconFlow Free Models
# Run sdf --free-api-help for API key registration links.

# Optional preferred technical domain
# TRANSLATION_DOMAIN=computer science

# Vocabulary saving is disabled by default. Set an absolute path, then choose:
# off / all / terms / texts
SAVE_MODE=off
# VOCABULARY_FILE=/home/your-name/Documents/vocabulary.md

# Optional proxy when the terminal does not inherit a system proxy
# HTTPS_PROXY=http://127.0.0.1:7890
